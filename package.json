{
  "name": "relay-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "中转沙箱：受控的多 Agent Docker 开发与交付",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "relay-sandbox": "dist/src/cli/main.js"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-assets.mjs",
    "lint": "eslint . && node scripts/check-length.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:docker": "RELAY_DOCKER_TEST=1 vitest run tests/integration",
    "test:e2e": "RELAY_DOCKER_TEST=1 vitest run tests/e2e",
    "prebuild": "node scripts/clean-build.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "15.0.0",
    "dockerode": "5.0.1",
    "picomatch": "4.0.7",
    "tar-stream": "3.2.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/dockerode": "4.0.2",
    "@types/node": "24.19.2",
    "@types/picomatch": "4.0.3",
    "@types/tar-stream": "3.1.5",
    "eslint": "10.14.0",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
